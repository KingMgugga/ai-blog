{
  "name": "ai-blog",
  "compatibility_date": "2026-11-10",
  "routes": [
    {
      "pattern": "ai.sliceanalytics.xyz",
      "custom_domain": true
    }
  ],
  "main": "worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "none",
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
